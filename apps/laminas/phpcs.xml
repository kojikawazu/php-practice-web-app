<?xml version="1.0"?>
<ruleset name="Laminas Coding Standard">
    <description>Laminas Coding Standard</description>

    <!-- display progress -->
    <arg value="p"/>
    <arg name="colors"/>
    <arg name="extensions" value="php,dist,phtml"/>

    <!-- inherit rules from: -->
    <rule ref="PSR12"/>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.Formatting.SpaceAfterNot"/>
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
        <properties>
            <property name="ignoreBlankLines" value="false"/>
        </properties>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>public/index.php</exclude-pattern>
    </rule>

    <!-- declare(strict_types=1) の宣言漏れを検出する（issue #135）。
         宣言の有無は実行時の型変換を変えるが、それを見るゲートがどこにも無く、
         module/ の 44/44 はスケルトンの慣習に従っていただけだった。
         spacesCountAroundEqualsSign=0 は本リポジトリの書き方（strict_types=1）に合わせる
         （sniff の既定は 1 で strict_types = 1 を要求する）。
         除外は下の PSR12.Files.FileHeader と同じ範囲。config/ はフレームワークへ渡す
         配列を返すだけのファイル、*.phtml は出力テンプレートで、いずれも「自作クラス」ではない
         （両 Laravel でも config/ を対象外にしている。issue #66）。 -->
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
        <properties>
            <property name="spacesCountAroundEqualsSign" value="0"/>
        </properties>
        <exclude-pattern>config/*</exclude-pattern>
        <exclude-pattern>*.phtml</exclude-pattern>
    </rule>

    <!-- view files adjustments -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*.phtml</exclude-pattern>
    </rule>
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>config/*</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
        <exclude-pattern>*.phtml</exclude-pattern>
    </rule>

    <!-- Paths to check -->
    <file>config</file>
    <file>module</file>
    <file>public/index.php</file>
</ruleset>
