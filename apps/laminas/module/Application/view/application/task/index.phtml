<?php
$this->headTitle('タスク一覧 (laminas)');
$base = $this->url('tasks');
?>
<p>
    <?= $this->escapeHtml($username) ?> さん
    <a href="<?= $this->url('logout') ?>">ログアウト</a>
</p>

<h1>タスク一覧 <small>laminas / TableGateway</small></h1>

<?php if (! empty($errors)): ?>
    <ul style="color:red">
        <?php foreach ($errors as $e): ?>
            <li><?= $this->escapeHtml($e) ?></li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<form method="post" action="<?= $base ?>">
    <input type="text" name="title" placeholder="タスク名">
    <button type="submit">追加</button>
</form>

<form method="get" action="<?= $base ?>">
    <input type="text" name="q" placeholder="タイトルで検索" value="<?= $this->escapeHtmlAttr($q) ?>">
    <button type="submit">検索</button>
    <?php if ($q !== ''): ?>
        <a href="<?= $base ?>">クリア</a>
    <?php endif; ?>
</form>

<ul>
<?php foreach ($tasks as $task): ?>
    <li>
        <span<?= $task->done ? ' style="text-decoration:line-through"' : '' ?>>
            <?= $this->escapeHtml($task->title) ?>
        </span>
        <a href="<?= $this->url('tasks', ['action' => 'edit', 'id' => $task->id]) ?>">編集</a>
        <a href="<?= $this->url('tasks', ['action' => 'duplicate', 'id' => $task->id]) ?>">複製</a>
        <a href="<?= $this->url('tasks', ['action' => 'delete', 'id' => $task->id]) ?>">削除</a>
    </li>
<?php endforeach; ?>
</ul>

<?php if ($total === 0): ?>
    <p>タスクはありません。</p>
<?php endif; ?>

<p>
    <?php if ($page > 1): ?>
        <a href="<?= $base ?>?q=<?= rawurlencode($q) ?>&amp;page=<?= $page - 1 ?>">前へ</a>
    <?php endif; ?>
    ページ <?= $page ?> / <?= $totalPages ?>（全 <?= $total ?> 件）
    <?php if ($page < $totalPages): ?>
        <a href="<?= $base ?>?q=<?= rawurlencode($q) ?>&amp;page=<?= $page + 1 ?>">次へ</a>
    <?php endif; ?>
</p>
