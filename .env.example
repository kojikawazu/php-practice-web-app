# MySQL（共有DB）。docker compose と各アプリの .env で参照する
MYSQL_DATABASE=php_practice
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=app
MYSQL_PASSWORD=secret

# ホスト側の公開ポート（既に使っているポートがある場合だけ変更する）。
# アプリ間は compose ネットワークで繋がるため、ここを変えても動作は変わらない。
MYSQL_PORT=3306
FS_PORT=8001
API_PORT=8002
LAMINAS_PORT=8003

# 各アプリの Laravel .env では以下を使う想定
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=php_practice
# DB_USERNAME=app
# DB_PASSWORD=secret
